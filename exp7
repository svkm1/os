
#include <stdio.h>

int main()
{
    int n, m, i, j, found;
    int alloc[10][10], req[10][10];
    int avail[10], work[10];
    int finish[10] = {0};

    printf("Enter number of processes and resources: ");
    scanf("%d%d", &n, &m);

    printf("Enter Allocation Matrix:\n");
    for(i = 0; i < n; i++)
        for(j = 0; j < m; j++)
            scanf("%d", &alloc[i][j]);

    printf("Enter Request Matrix:\n");
    for(i = 0; i < n; i++)
        for(j = 0; j < m; j++)
            scanf("%d", &req[i][j]);

    printf("Enter Available Resources:\n");
    for(j = 0; j < m; j++)
    {
        scanf("%d", &avail[j]);
        work[j] = avail[j];
    }

    // Processes holding no resources can finish
    for(i = 0; i < n; i++)
    {
        found = 0;

        for(j = 0; j < m; j++)
            if(alloc[i][j] != 0)
                found = 1;

        if(found == 0)
            finish[i] = 1;
    }

    do
    {
        found = 0;

        for(i = 0; i < n; i++)
        {
            if(finish[i] == 0)
            {
                for(j = 0; j < m; j++)
                    if(req[i][j] > work[j])
                        break;

                if(j == m)
                {
                    for(j = 0; j < m; j++)
                        work[j] += alloc[i][j];

                    finish[i] = 1;
                    found = 1;
                }
            }
        }

    } while(found);

    found = 0;

    printf("\nDeadlocked Processes: ");

    for(i = 0; i < n; i++)
    {
        if(finish[i] == 0)
        {
            printf("P%d ", i);
            found = 1;
        }
    }

    if(found == 0)
        printf("None. No deadlock detected.");

    return 0;
}
