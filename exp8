
#include <stdio.h>

void firstFit(int block[], int b, int process[], int p)
{
    int i, j, temp[20];

    for(j = 0; j < b; j++)
        temp[j] = block[j];

    printf("\nFirst Fit:\n");

    for(i = 0; i < p; i++)
    {
        for(j = 0; j < b; j++)
        {
            if(temp[j] >= process[i])
            {
                printf("P%d allocated to Block %d\n",
                       i+1, j+1);
                temp[j] = -1;
                break;
            }
        }

        if(j == b)
            printf("P%d Not Allocated\n", i+1);
    }
}

void bestFit(int block[], int b, int process[], int p)
{
    int i, j, best, temp[20];

    for(j = 0; j < b; j++)
        temp[j] = block[j];

    printf("\nBest Fit:\n");

    for(i = 0; i < p; i++)
    {
        best = -1;

        for(j = 0; j < b; j++)
        {
            if(temp[j] >= process[i])
            {
                if(best == -1 || temp[j] < temp[best])
                    best = j;
            }
        }

        if(best != -1)
        {
            printf("P%d allocated to Block %d\n",
                   i+1, best+1);
            temp[best] = -1;
        }
        else
            printf("P%d Not Allocated\n", i+1);
    }
}

void worstFit(int block[], int b, int process[], int p)
{
    int i, j, worst, temp[20];

    for(j = 0; j < b; j++)
        temp[j] = block[j];

    printf("\nWorst Fit:\n");

    for(i = 0; i < p; i++)
    {
        worst = -1;

        for(j = 0; j < b; j++)
        {
            if(temp[j] >= process[i])
            {
                if(worst == -1 || temp[j] > temp[worst])
                    worst = j;
            }
        }

        if(worst != -1)
        {
            printf("P%d allocated to Block %d\n",
                   i+1, worst+1);
            temp[worst] = -1;
        }
        else
            printf("P%d Not Allocated\n", i+1);
    }
}

int main()
{
    int b, p, block[20], process[20], i;

    printf("Enter number of memory blocks: ");
    scanf("%d", &b);

    printf("Enter block sizes:\n");
    for(i = 0; i < b; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &p);

    printf("Enter process sizes:\n");
    for(i = 0; i < p; i++)
        scanf("%d", &process[i]);

    firstFit(block, b, process, p);
    bestFit(block, b, process, p);
    worstFit(block, b, process, p);

    return 0;
}
